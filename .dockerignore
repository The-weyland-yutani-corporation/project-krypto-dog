# Keep the Docker build context small and avoid leaking local secrets/state
# into any image layer.

# Dependency & build artifacts (reinstalled/rebuilt inside the image)
node_modules
.next
out
coverage
*.tsbuildinfo

# Local environment / secrets — never bake these into an image
.env
.env.*
!.env.example

# VCS / editor / OS noise
.git
.gitignore
.github
.vscode
.idea
*.log
.DS_Store

# Docs, specs, and test-only assets not needed at runtime
docs
specs
README.md
tests

# Local database / infra tooling not needed inside application images
docker-compose.yml
supabase
infra

# CI artifacts
.next/cache
