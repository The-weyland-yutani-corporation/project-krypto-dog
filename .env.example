# Environment Variables for Project Krypto
# Copy to .env and fill in values.
#
# Deployment target: this repo's Azure-native runbook is implemented (Bicep
# under infra/, GitHub Actions OIDC workflows, ops-job code) but no real
# Azure environment has been provisioned yet -- see specs/deployment.md and
# ADR specs/decisions/0008-azure-native-deployment-architecture.md. See
# specs/readiness.md for the remaining production evidence/promotion gates.
# `db:init` is idempotent and never deletes trading history.

# The application invokes a version-pinned prompt agent for decisions.
# Production uses the assigned workload identity selected by AZURE_CLIENT_ID;
# no model API key is accepted or stored.
AZURE_FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/krypto-dev-agents
AZURE_FOUNDRY_AGENT_NAME=krypto-dev-decision
AZURE_FOUNDRY_AGENT_VERSION=1
# Required in Azure production. Local attended smoke may use `az login`.
# AZURE_CLIENT_ID=<runtime-or-ops-user-assigned-identity-client-id>

# Optional direct-model diagnostics (`npm run smoke:llm`) use the platform
# operator identity, never the application runtime identity.
# AZURE_OPENAI_BASE_URL=https://your-resource.openai.azure.com/openai/v1/
# AZURE_OPENAI_DEPLOYMENT_NAME=krypto-dev-luna

# PostgreSQL
# Local (Docker Compose — port 5433). Keep these values for local dev.
DATABASE_URL=******localhost:5433/krypto
DIRECT_URL=******localhost:5433/krypto
# `drizzle-kit migrate` (npm run db:migrate) requires MIGRATION_URL as the
# dedicated least-privilege krypto_migrator role -- never DIRECT_URL or
# DATABASE_URL (see specs/decisions/0011-postgresql-trust-boundary-roles.md).
# Locally, run the one-time bootstrap first (creates krypto_migrator against
# DIRECT_URL's superuser):
#   KRYPTO_MIGRATOR_LOGIN_PASSWORD=krypto_local \
#     npx tsx scripts/bootstrap-azure-runtime-role.ts --mode database-roles
# Re-run the same bootstrap after `npm run db:migrate` to remove the temporary
# public-schema CREATE grant required by historical fresh-install migrations.
MIGRATION_URL=postgresql://krypto_migrator:krypto_local@localhost:5433/krypto
# Azure Database for PostgreSQL Flexible Server 17 (implemented Azure
# runbook target -- infra/environment.bicep, private VNet access only, no
# public endpoint). DATABASE_URL, DIRECT_URL, and MIGRATION_URL point at the
# same server/database; there is no separate pooler endpoint like Supabase's
# port 6543. DATABASE_URL uses the least-privilege runtime login
# (`krypto_app`). DIRECT_URL uses the server administrator (`krypto_owner`)
# and is available only to reviewed operations jobs, for idempotent role
# bootstrap and privileged inventory/backup -- never migrations. MIGRATION_URL
# uses the dedicated least-privilege migrator role (`krypto_migrator`) and is
# available only to the migrate-init job (plus read-only to preflight); it is
# never mounted on web/scheduler/verified-backup/target-smoke/activation-check.
# The password embedded in DATABASE_URL must equal RUNTIME_DATABASE_PASSWORD;
# in MIGRATION_URL must equal MIGRATOR_DATABASE_PASSWORD; in DIRECT_URL must
# equal POSTGRES_ADMIN_PASSWORD. sslmode=require is mandatory -- Flexible
# Server rejects unencrypted connections.
# DATABASE_URL=postgresql://krypto_app:<password>@<server-name>.postgres.database.azure.com:5432/postgres?sslmode=require
# DIRECT_URL=postgresql://krypto_owner:<password>@<server-name>.postgres.database.azure.com:5432/postgres?sslmode=require
# MIGRATION_URL=postgresql://krypto_migrator:<password>@<server-name>.postgres.database.azure.com:5432/postgres?sslmode=require
# Bounded runtime contract (release/rollout Bicep supplies these in Azure).
DATABASE_POOL_MAX=1
AGENT_RUN_ADMISSION_CAPACITY=1
COINBASE_DAILY_REQUEST_BUDGET=1000
FOUNDRY_DAILY_REQUEST_BUDGET=200
POSTHOG_DAILY_REQUEST_BUDGET=2000
ACS_DAILY_REQUEST_BUDGET=100
EXECUTION_CONTRACT_VERSION=bounded-sync-v1
# RELEASE_SHA=<40-lowercase-hex-commit-sha>
# IMAGE_DIGEST=sha256:<64-lowercase-hex>

# PostHog (Observability)
POSTHOG_API_KEY=phc_your-key
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_ENVIRONMENT=dev

# Cron Authentication
CRON_SECRET=your-cron-secret

# Public web origin used for strict admin CSRF validation behind Azure ingress.
# Required in production; use only scheme + host (no path, query, or fragment).
# APP_ORIGIN=https://<container-app-fqdn>

# Azure Communication Services Email
# The production connection string is sourced from Key Vault. Local/test may
# omit these values and receive an explicit console-only skipped result.
# AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://your-resource.communication.azure.com/;accesskey=your-key
# AZURE_COMMUNICATION_EMAIL_SENDER=DoNotReply@your-managed-domain.azurecomm.net
ALERT_EMAIL_TO=you@example.com

# Admin Dashboard
ADMIN_PASSWORD=your-admin-password
# Required in production: dedicated HMAC key for admin session cookies.
# Local development can fall back to CRON_SECRET, but production startup
# validation rejects a missing dedicated value.
ADMIN_SESSION_SECRET=your-admin-session-secret

# Rollout mode -- implemented by the v2.1 orchestration layer.
# Values: disabled | shadow | paper
# - disabled: agent runs are skipped entirely (no LLM call)
# - shadow:   full loop runs but approved trades are NOT recorded
# - paper:    full loop runs and approved trades ARE recorded
# Production must remain disabled/manual. No executable production promotion
# workflow is shipped or approved; any future path requires a new evidence-bound
# design and review (see specs/deployment.md §11). release.bicep hardcodes the
# deploy-time default, and committed rollout params also default disabled/Manual.
ROLLOUT_MODE=disabled

# Production-paper responder roster. These are non-secret named assignments,
# not generic placeholders. Missing/placeholder values block shadow/PAPER
# readiness and the target-smoke safety drill contract. Release owner and
# safety approver, and primary/backup on-call, must be distinct.
# SAFETY_PRIMARY_ON_CALL=<named assignment>
# SAFETY_BACKUP_ON_CALL=<named assignment>
# SAFETY_RELEASE_OWNER=<named assignment>
# SAFETY_APPROVER=<named assignment>
# SAFETY_EVIDENCE_CUSTODIAN=<named assignment>
# SAFETY_ROLLBACK_OWNER=<named assignment>
# Each responder owns a distinct Ed25519 private key. Configure only the
# base64-encoded SPKI public keys here; private keys never enter Krypto, GitHub,
# Azure configuration, logs, incidents, or evidence.
# SAFETY_PRIMARY_ON_CALL_PUBLIC_KEY=<base64-ed25519-spki>
# SAFETY_BACKUP_ON_CALL_PUBLIC_KEY=<base64-ed25519-spki>
# SAFETY_RELEASE_OWNER_PUBLIC_KEY=<base64-ed25519-spki>
# SAFETY_APPROVER_PUBLIC_KEY=<base64-ed25519-spki>
# SAFETY_EVIDENCE_CUSTODIAN_PUBLIC_KEY=<base64-ed25519-spki>
# SAFETY_ROLLBACK_OWNER_PUBLIC_KEY=<base64-ed25519-spki>
# Persisted test fires remain disabled except during an explicitly attended,
# non-trading drill. Source/CI validation uses dryRun=true and never changes it.
SAFETY_INCIDENT_DRILL_ENABLED=false

# --- Azure ops-job-only variables (not needed for local dev) ---
# Consumed by scripts/azure/ops-job.ts and its operations (preflight,
# migrate-init, verified-backup, target-smoke, activation-check) when run
# inside an Azure Container Apps Job -- see infra/README.md "Five separate
# manual operations jobs". Set by release.bicep from GitHub Environment
# secrets/variables at deploy time; never committed here with real values.
# ENVIRONMENT_NAME=dev
# RELEASE_SHA=<40-hex-commit-sha>
# JOB_EXECUTION_ID=<unique-per-invocation-id>
# EVIDENCE_CONTAINER_URL=https://<storage-account>.blob.core.windows.net/evidence
# AZCOPY_MSI_CLIENT_ID=<ops-identity-client-id>
# AZURE_RUNTIME_LOGIN_ROLE=krypto_app
# KRYPTO_MIGRATOR_LOGIN_PASSWORD=<migrator-password -- migrate-init only;
#   maps to the MIGRATOR_DATABASE_PASSWORD GitHub Environment secret; must
#   equal the password embedded in MIGRATION_URL; never mounted on
#   preflight/verified-backup/target-smoke/activation-check>
# TARGET_BASE_URL=https://<container-app-fqdn>
# TARGET_CONFIRM_HOST=<container-app-fqdn>
# IMAGE_DIGEST=sha256:<64-hex>
# DEPLOYMENT_APPROVAL_SECRET=<HMAC-SHA256 key -- target-smoke/activation-check
#   only, sourced from the DEPLOYMENT_APPROVAL_SECRET secret in each GitHub
#   Environment; the workflows map it to the internal _DEV/_PROD Bicep env
#   name. Never bound to the other ops jobs or the web/runtime container.>
