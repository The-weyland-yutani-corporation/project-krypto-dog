# Environment Variables for Project Krypto
# Copy to .env and fill in values.
#
# WARNING: v2.1 is locally release-gated but the target deployment is not ready.
# See specs/readiness.md for the remaining v2.2 production gates.
# Production database credentials are currently stale and the remote schema is
# unknown. Complete inventory and backup gates before `db:migrate`; `db:init`
# is idempotent and never deletes trading history.

# Azure AI Foundry-hosted Anthropic (LLM Engine)
# Preferred variable names (use these for new deployments):
#   ANTHROPIC_FOUNDRY_BASE_URL  – the full /anthropic base URL
#     For Foundry (services.ai.azure.com): https://your-resource.services.ai.azure.com/anthropic
#     For legacy OpenAI resource (openai.azure.com): leave unset; app derives it from AZURE_OPENAI_ENDPOINT
#   ANTHROPIC_FOUNDRY_API_KEY   – Azure subscription key (not an OpenAI key)
#   ANTHROPIC_FOUNDRY_DEPLOYMENT – Claude model deployment name
#   ANTHROPIC_FOUNDRY_API_VERSION – optional, defaults to 2024-10-21
ANTHROPIC_FOUNDRY_BASE_URL=https://your-resource.services.ai.azure.com/anthropic
ANTHROPIC_FOUNDRY_API_KEY=your-api-key
ANTHROPIC_FOUNDRY_DEPLOYMENT=your-anthropic-model-deployment
# Optional. Defaults to 2024-10-21 (latest GA at time of writing).
# ANTHROPIC_FOUNDRY_API_VERSION=2024-10-21

# Legacy fallback names (still accepted for already-deployed environments):
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-api-key
# AZURE_OPENAI_DEPLOYMENT_NAME=your-anthropic-model-deployment
# AZURE_OPENAI_API_VERSION=2024-10-21

# Supabase PostgreSQL
# Local (Docker Compose — port 5433)
DATABASE_URL=postgresql://krypto:krypto_local@localhost:5433/krypto
DIRECT_URL=postgresql://krypto:krypto_local@localhost:5433/krypto
# Supabase (production)
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# PostHog (Observability)
POSTHOG_API_KEY=phc_your-key
POSTHOG_HOST=https://us.i.posthog.com

# Cron Authentication
CRON_SECRET=your-cron-secret

# Resend (Email Alerts)
RESEND_API_KEY=re_your-key
ALERT_EMAIL_TO=you@example.com
ALERT_EMAIL_FROM=krypto@yourdomain.com

# Admin Dashboard
ADMIN_PASSWORD=your-admin-password
# Required in production: dedicated HMAC key for admin session cookies.
# Local development can fall back to CRON_SECRET, but production startup
# validation rejects a missing dedicated value.
ADMIN_SESSION_SECRET=your-admin-session-secret

# Rollout mode -- implemented by the v2.1 orchestration layer.
# Values: disabled | shadow | paper
# - disabled: agent runs are skipped entirely (no LLM call)
# - shadow:   full loop runs but approved trades are NOT recorded
# - paper:    full loop runs and approved trades ARE recorded
# Production must start disabled and promote only through the reviewed gates.
ROLLOUT_MODE=disabled
