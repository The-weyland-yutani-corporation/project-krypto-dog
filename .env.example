# Environment Variables for Project Krypto
# Copy to .env and fill in values

# Azure OpenAI (LLM Engine)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
# Optional. Defaults to 2024-10-21 (latest GA at time of writing).
# Bump if you need preview features (e.g. 2025-01-01-preview).
AZURE_OPENAI_API_VERSION=2024-10-21

# Coinbase Developer Platform (AgentKit)
CDP_API_KEY_NAME=your-cdp-key-name
CDP_API_KEY_PRIVATE_KEY=your-cdp-private-key

# Supabase PostgreSQL
# Local (Docker Compose — port 5433)
DATABASE_URL=postgresql://krypto:krypto_local@localhost:5433/krypto
DIRECT_URL=postgresql://krypto:krypto_local@localhost:5433/krypto
# Supabase (production)
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# PostHog (Observability)
POSTHOG_API_KEY=phc_your-key
POSTHOG_HOST=https://us.i.posthog.com

# Cron Authentication
CRON_SECRET=your-cron-secret

# Resend (Email Alerts)
RESEND_API_KEY=re_your-key
ALERT_EMAIL_TO=you@example.com
ALERT_EMAIL_FROM=krypto@yourdomain.com

# Admin Dashboard
ADMIN_PASSWORD=your-admin-password
# Optional but recommended in production: dedicated HMAC key for admin
# session cookies. Falls back to CRON_SECRET (with a runtime warning) when
# unset, but reusing one secret for two purposes is discouraged.
ADMIN_SESSION_SECRET=your-admin-session-secret
