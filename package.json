    "agentic:links": "npx tsx scripts/check-markdown-links.ts",
    "agentic:instructions": "npx tsx scripts/check-agent-instructions.ts",
    "agentic:compile": "gh aw compile --strict",
    "harness:check": "npx tsx scripts/check-harness-integrity.ts",
    "monitor:collect": "node scripts/agentic/collect-factory-health.cjs --mode governance",
    "monitor:collect:daily": "node scripts/agentic/collect-factory-health.cjs --mode daily",
    "entropy:collect": "node scripts/agentic/collect-agentic-entropy.cjs",
    "entropy:check": "node scripts/agentic/collect-agentic-entropy.cjs --check",
    "corrections:collect": "node scripts/agentic/collect-agentic-corrections.cjs",
