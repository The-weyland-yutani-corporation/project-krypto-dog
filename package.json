{
  "name": "project-krpyto-dog",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "test": "jest",
    "test:unit": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand --silent",
    "test:integration": "npm run test:migrations",
    "test:agentic-sdlc": "jest --runInBand tests/agentic-sdlc",
    "test:watch": "jest --watch",
    "smoke:llm": "npx tsx scripts/smoke-llm.ts",
    "smoke:providers": "npx tsx scripts/smoke-providers.ts",
    "harness:up": "npx tsx scripts/agent-harness.ts up",
    "harness:status": "npx tsx scripts/agent-harness.ts status",
    "harness:down": "npx tsx scripts/agent-harness.ts down",
    "harness:smoke": "npx tsx scripts/agent-harness.ts smoke",
    "harness:browser": "playwright test --config playwright.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:init": "npx tsx scripts/seed.ts",
    "db:reset": "npx tsx scripts/reset-state.ts",
    "test:migrations": "bash scripts/test-migrations.sh",
    "agentic:policy": "npx tsx scripts/validate-agentic-policy.ts",
