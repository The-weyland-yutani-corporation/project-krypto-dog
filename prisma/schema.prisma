generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TradeDirection {
  BUY
  SELL
}

model AgentState {
  id                 String   @id @default("singleton")
  lastTradePrice     Float?
  currentPositionETH Float    @default(0)
  currentPositionUSDC Float   @default(200)
  portfolioValueUSD  Float    @default(200)
  isLocked           Boolean  @default(false)
  isRunning          Boolean  @default(false)
  lastRunAt          DateTime?
  updatedAt          DateTime @updatedAt
}

model TradeExecution {
  id              String         @id @default(cuid())
  direction       TradeDirection
  asset           String
  amountUSD       Float
  amountAsset     Float
  executionPrice  Float
  feesUSD         Float          @default(0)
  slippage        Float          @default(0)
  pnlUSD          Float?
  agentReasoning  String         @db.Text
  createdAt       DateTime       @default(now())

  journalEntries  AgentJournal[]

  @@index([createdAt])
}

model AgentJournal {
  id                String          @id @default(cuid())
  entryText         String          @db.Text
  marketConditions  Json
  tradeExecutionId  String?
  tradeExecution    TradeExecution? @relation(fields: [tradeExecutionId], references: [id])
  createdAt         DateTime        @default(now())

  @@index([createdAt])
}
